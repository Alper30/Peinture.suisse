# Peinture Suisse — ortam değişkenleri örneği
#
# BU DOSYA ŞABLONDUR, gerçek değer İÇERMEZ ve git'e girer.
# Gerçek anahtarları .env.local dosyasına yazın — o dosya .gitignore'da,
# asla commit edilmez ve kimseyle paylaşılmaz.
#
# Kurulum:  cp .env.example .env.local   → sonra değerleri doldurun
# Canlıda:  Vercel → Project → Settings → Environment Variables

# --- Devis (teklif) formu e-postası ---
# Gönderim Infomaniak SMTP üzerinden yapılır. Alan adı Infomaniak'ta olduğu
# için SPF, DKIM ve DMARC kayıtları ZATEN bu sunucuyu yetkilendiriyor —
# başka bir sağlayıcı kullanmak istenirse DNS'teki SPF de genişletilmeli,
# yoksa `-all` + `p=reject` yüzünden e-postalar sessizce reddedilir.

# Posta kutusunun tam adresi. Bu aynı zamanda GÖNDERİCİ adresidir:
# SMTP sunucusu, kimlik doğrulanan kutudan başkası adına gönderime izin vermez.
# Örn: contact@peinture-suisse-romande.ch
SMTP_USER=

# Posta kutusunun şifresi (Infomaniak → Mail Service → ilgili adres).
# YOKSA: form gönderimleri e-postaya DÜŞMEZ, müşteri dürüst bir hata görüp
# telefon/WhatsApp'a yönlendirilir.
SMTP_PASSWORD=

# Teklif taleplerinin gideceği adres.
# Boş bırakılırsa lib/site-config.ts içindeki `email` alanı kullanılır.
CONTACT_EMAIL_TO=

# --- İsteğe bağlı, normalde doldurulmaz ---
# Sunucu ve port; varsayılanlar alan adının SRV kayıtlarından alındı
# (mail.infomaniak.com / 465, implicit TLS). Yalnızca sağlayıcı değişirse yazın.
SMTP_HOST=
SMTP_PORT=

# Görünen gönderici. Boşsa SMTP_USER kullanılır — normalde bu doğrudur.
# Yalnızca görünen ad eklemek için yazın:
#   Peinture Suisse <contact@peinture-suisse-romande.ch>
# DİKKAT: adres kısmı SMTP_USER ile AYNI olmalı, yoksa sunucu reddeder.
CONTACT_EMAIL_FROM=

# --- Clerk (espace client / kimlik doğrulama) ---
# https://dashboard.clerk.com → API Keys
#
# Tarayıcıya gider, GİZLİ DEĞİLDİR. Ayrıca build sırasında okunup CSP'deki
# Clerk alan adı buradan türetilir (bkz. next.config.ts) — yoksa CSP joker
# alan adlarına düşer, yani uyarı vermeden gevşer.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# GİZLİ — asla commit edilmez, asla paylaşılmaz.
CLERK_SECRET_KEY=

# NOT: Canlıya çıkarken Clerk'in PRODUCTION instance anahtarlarını kullanın.
# pk_test_/sk_test_ ile başlayanlar geliştirme örneğidir: kullanıcı sınırı,
# hız limiti ve "development mode" rozeti gelir.

# --- İsteğe bağlı ---
# Site adresi (boş bırakılırsa Vercel'in verdiği adres otomatik kullanılır).
# Kendi alan adınızı aldığınızda buraya yazın: https://peinture-suisse-romande.ch
# (peinture-suisse.ch BİZE AİT DEĞİL — örnek olarak bile yazmayın, bkz. lib/site-config.ts)
# DİKKAT: build sırasında gömülür — değiştirdikten sonra yeniden deploy şart,
# yoksa sitemap/robots/canonical eski adresi göstermeye devam eder.
NEXT_PUBLIC_SITE_URL=
