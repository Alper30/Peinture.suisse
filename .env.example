# Peinture Suisse — ortam değişkenleri örneği
#
# BU DOSYA ŞABLONDUR, gerçek değer İÇERMEZ ve git'e girer.
# Gerçek anahtarları .env.local dosyasına yazın — o dosya .gitignore'da,
# asla commit edilmez ve kimseyle paylaşılmaz.
#
# Kurulum:  cp .env.example .env.local   → sonra değerleri doldurun
# Canlıda:  Vercel → Project → Settings → Environment Variables

# --- Devis (teklif) formu e-postası ---
# Resend API anahtarı. https://resend.com → API Keys
# YOKSA: form gönderimleri e-postaya DÜŞMEZ, yalnızca sunucu loguna yazılır.
RESEND_API_KEY=

# Teklif taleplerinin gideceği e-posta adresi
CONTACT_EMAIL_TO=

# --- İsteğe bağlı ---
# Site adresi (boş bırakılırsa Vercel'in verdiği adres otomatik kullanılır).
# Kendi alan adınızı aldığınızda buraya yazın: https://peinture-suisse.ch
NEXT_PUBLIC_SITE_URL=
